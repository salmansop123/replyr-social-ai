# Copy to frontend/.env.local (gitignored)

NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_URL=http://localhost:8000

# Clerk — get from https://dashboard.clerk.com → API Keys
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...

# Leave publishable key empty to use offline dev auth (see backend DEV_AUTH_ENABLED).

# Dashboard overview + inbox sample data (true | false | unset = preview in dev when API is empty)
# NEXT_PUBLIC_DASHBOARD_DEMO=true

# Phase 4 — Stripe (Dashboard → Products → copy Price IDs)
NEXT_PUBLIC_BILLING_DEMO=false
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_STRIPE_PRICE_STARTER=price_...
NEXT_PUBLIC_STRIPE_PRICE_PROFESSIONAL=price_...
NEXT_PUBLIC_STRIPE_PRICE_ENTERPRISE=price_...
