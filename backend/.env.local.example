# Copy to backend/.env.local (gitignored). Used when API/Celery run on your machine.
# Overrides docker-compose hostnames from backend/.env.

# Port 5433 avoids conflict with a system PostgreSQL on 5432 (see scripts/infra-up.sh).
DATABASE_URL=postgresql://replyr:replyr_dev@localhost:5433/replyr
REDIS_URL=redis://localhost:6379/0

# Local dashboard without Clerk keys (pairs with frontend offline auth).
DEV_AUTH_ENABLED=true

# Add when ready for real sign-in + AI replies:
# CLERK_DOMAIN=your-app.clerk.accounts.dev
# CLERK_SECRET_KEY=sk_test_...
# OPENROUTER_API_KEY=sk-or-...
