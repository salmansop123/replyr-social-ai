# Application
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
FRONTEND_URL=http://localhost:3000
ENCRYPTION_KEY=change-me-32-byte-key-for-token-enc

# Database — use localhost when API/Celery run on your machine (docker compose exposes ports).
# Use postgres/redis hostnames only when the app runs INSIDE docker compose (see docker-compose.yml).
# Host dev: copy .env.local.example → .env.local (port 5433 if system Postgres uses 5432).
DATABASE_URL=postgresql://replyr:replyr_dev@localhost:5432/replyr
REDIS_URL=redis://localhost:6379/0

# Docker Compose only (backend/worker containers):
# DATABASE_URL=postgresql://replyr:replyr_dev@postgres:5432/replyr
# REDIS_URL=redis://redis:6379/0

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PROFESSIONAL=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# OpenRouter
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_DEFAULT_MODEL=anthropic/claude-3-haiku

# AI Training document storage (PDF / Excel / CSV uploads)
KNOWLEDGE_STORAGE_DIR=data/knowledge
KNOWLEDGE_MAX_UPLOAD_MB=10

# WhatsApp / Meta configuration
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_VERIFY_TOKEN=replyr_webhook_verify_2024
# any random string you choose — must match Meta Developer Console webhook verify token

# Your production webhook URL (use ngrok URL for local testing)
# Register this in Meta Developer Console → WhatsApp → Configuration
WEBHOOK_BASE_URL=https://your-ngrok-url.ngrok.io

# WhatsApp Cloud API (Graph v18): access token + Phone Number ID from Meta Business Manager
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=

# Facebook Pages OAuth — redirect must match Meta app → Facebook Login → Valid OAuth Redirect URIs
# Example (local API): http://localhost:8000/api/v1/social/callback/facebook
META_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/social/callback/facebook

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Email
RESEND_API_KEY=
FROM_EMAIL=noreply@replyr.ai

# Sentry (optional)
SENTRY_DSN=
